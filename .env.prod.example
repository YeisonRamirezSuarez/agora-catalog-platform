# Variables de docker-compose.prod.yml. Copiar como `.env` en la raíz del repo del servidor
# (ignorado por git) y completar. Docker Compose lo lee solo.

# Dominio propio apuntando a este servidor (registro A). Caddy saca el certificado HTTPS solo.
DOMAIN='catalogo.ejemplo.com'

# Base de datos (la crea el contenedor de PostgreSQL la primera vez).
DB_USERNAME='agora'
DB_PASSWORD='CAMBIAR'

# Firma de los JWT. Generar con: openssl rand -base64 64
JWT_SECRET='CAMBIAR'

# Cifra la contraseña del proveedor de correo. Generar con: openssl rand -hex 32
# No cambiarla después: lo ya cifrado deja de leerse.
AES_KEY='CAMBIAR'

# Super admin: se crea en el primer arranque y se le pide cambiar la contraseña al entrar.
SUPERADMIN_NAME='Nombre Apellido'
SUPERADMIN_EMAIL='correo@ejemplo.com'
SUPERADMIN_PASSWORD='CAMBIAR'

# Respaldos (scripts/respaldo/respaldar.sh)
# RESPALDO_DIR='/var/backups/agora-catalog'
# RESPALDO_DIAS='14'
# Copia fuera del VPS con rclone (configurado antes con `rclone config`), ej. 'r2:agora-respaldos'
# RESPALDO_REMOTO=''
