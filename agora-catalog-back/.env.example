# =============================================================================
# Variables de entorno del backend
# =============================================================================
# Copiar este archivo como `.env` (mismo directorio) y completar los valores.
# `.env` está en .gitignore: nunca se versiona.
#
# El backend lo carga solo al arrancar (SecretsEnvironmentPostProcessor). Lo que
# ya esté definido en el entorno del sistema tiene prioridad sobre este archivo.
# Usar comillas simples para evitar que el shell interprete caracteres como `$`.
# -----------------------------------------------------------------------------

# --- Obligatorias ------------------------------------------------------------

# Base de datos: PostgreSQL 16 o superior instalado en la máquina. La base se crea
# una vez a mano (CREATE DATABASE agora_catalog); el esquema `main` lo crea Flyway.
DB_URL='jdbc:postgresql://localhost:5432/agora_catalog?currentSchema=main'
DB_USERNAME='postgres'
DB_PASSWORD='CAMBIAR'

# --- Opcionales (tienen valor por defecto) -----------------------------------

# SPRING_PROFILES_ACTIVE='local'
# SERVER_PORT='9092'
# APP_TIME_ZONE='America/Bogota'
# CORS_ALLOWED_ORIGINS='http://localhost:4251'
# TRUSTED_PROXY_COUNT='0'
# FLYWAY_ENABLED='true'

# Solo perfiles `dev` y `prod`: carpeta de logs.
# LOG_PATH='./logs'
